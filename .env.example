# Copy this file to .env.local and fill in your own values.
# Find these in your Supabase project dashboard under Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key (same page, under "Secret keys"). NEVER put this in a
# NEXT_PUBLIC_ variable - it gives full access to your database and must
# only ever be read on the server. Used to invite clients by email.
SUPABASE_SECRET_KEY=your-secret-key

# Optional. Set this to your real domain once deployed (e.g. https://yourapp.com).
# Leave blank while developing locally - it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
